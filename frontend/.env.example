# Solo variables públicas: Vite las incrusta en el bundle, así que jamás debe
# colocarse aquí una credencial o un secreto.

# Ruta base de la API. En desarrollo se deja el valor relativo para aprovechar
# el proxy de Vite y evitar peticiones de origen cruzado.
VITE_API_URL=/api/v1

# Destino del proxy de desarrollo.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
