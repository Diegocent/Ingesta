# Plantilla de configuración. Copiar a `.env` y completar.
# El archivo `.env` NUNCA debe versionarse.

# Generar con: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ingesta-sen.yvagacore.com,127.0.0.1

# Motor PostgreSQL. En desarrollo local (Docker de infra/):
#   DATABASE_URL=postgres://sen:sen_dev_local@127.0.0.1:5434/sen_dw_dev
#   DB_SSLMODE=disable
# En un Neon NUEVO (nunca el de producción):
#   DATABASE_URL=postgres://usuario:contrasena@host:5432/sen_dw_dev
#   DB_SSLMODE=require
DATABASE_URL=postgres://usuario:contrasena@host:5432/sen_dw_dev
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Única lista de orígenes autorizados del frontend.
CORS_ALLOWED_ORIGINS=https://ingesta-sen.yvagacore.com
CSRF_TRUSTED_ORIGINS=https://ingesta-sen.yvagacore.com

# Clave de firma de los JWT. Debe ser distinta de DJANGO_SECRET_KEY para que
# la rotación de una no invalide el otro mecanismo.
JWT_SIGNING_KEY=

# Cuotas de tasa (formato de DRF: "N/segundo|minuto|hora|dia").
THROTTLE_LECTURA=180/min
THROTTLE_ESCRITURA=40/min
THROTTLE_AUTENTICACION=5/min

# Proxies inversos por delante de la aplicación (nginx, balanceador...).
NUM_PROXIES=1

# Backend de caché para los contadores de cuota. Con más de una instancia:
# CACHE_URL=redis://127.0.0.1:6379/1
CACHE_URL=locmemcache://ingesta

SECURE_SSL_REDIRECT=True
